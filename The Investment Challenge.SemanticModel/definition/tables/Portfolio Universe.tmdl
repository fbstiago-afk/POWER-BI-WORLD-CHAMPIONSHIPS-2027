		summarizeBy: none
		isNameInferred
		sourceColumn: [NetCashExpected]

	column RunRate2032Expected
		formatString: \$#,0
		lineageTag: 28be2d9d-06dd-45ee-833e-940e54371b8e
		summarizeBy: none
		isNameInferred
		sourceColumn: [RunRate2032Expected]

	column Option
		lineageTag: b7f2826e-4d16-4ec7-a7ec-93e32804fd1a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Option]

	partition 'Portfolio Universe' = calculated
		mode: import
		source =
				VAR _Brand = "Goodnight Inn"
				VAR _Budget = LOOKUPVALUE( Brands[InvestmentBudgetUSD], Brands[Brand], _Brand )
				VAR _Ids = SELECTCOLUMNS( FILTER( InvestmentProjects, InvestmentProjects[Brand] = _Brand ), "I", InvestmentProjects[ProjectID] )
				VAR _P =
				    ADDCOLUMNS(
				        SELECTCOLUMNS(
				            FILTER( InvestmentProjects, InvestmentProjects[Brand] = _Brand ),
				            "PID", InvestmentProjects[ProjectID],
				            "Capex", InvestmentProjects[CapexUSD],
				            "Growth", IF( InvestmentProjects[GrowthInitiative] = "Yes", 1, 0 ),
				            "Dep", InvestmentProjects[DependsOn],
				            "Exc", InvestmentProjects[ExclusiveWith]
				        ),
				        "Bit", VAR _me = [PID] RETURN COUNTROWS( FILTER( _Ids, [I] < _me ) ) + 0,
				        "NL", VAR _me = [PID] RETURN LOOKUPVALUE( 'Project Value'[NPV2026], 'Project Value'[ProjectID], _me, 'Project Value'[Scenario], "Low" ),
				        "NE", VAR _me = [PID] RETURN LOOKUPVALUE( 'Project Value'[NPV2026], 'Project Value'[ProjectID], _me, 'Project Value'[Scenario], "Expected" ),
				        "NH", VAR _me = [PID] RETURN LOOKUPVALUE( 'Project Value'[NPV2026], 'Project Value'[ProjectID], _me, 'Project Value'[Scenario], "High" ),
				        "CE", VAR _me = [PID] RETURN LOOKUPVALUE( 'Project Value'[NetCash2032], 'Project Value'[ProjectID], _me, 'Project Value'[Scenario], "Expected" ),
				        "RE", VAR _me = [PID] RETURN LOOKUPVALUE( 'Project Value'[RunRate2032], 'Project Value'[ProjectID], _me, 'Project Value'[Scenario], "Expected" )
				    )
				VAR _U =
				    GENERATE(
				        GENERATESERIES( 0, 1023, 1 ),
				        VAR _m = [Value]
				        VAR _inc = FILTER( _P, MOD( INT( _m / POWER( 2, [Bit] ) ), 2 ) = 1 )
				        VAR _incIds = SELECTCOLUMNS( _inc, "X", [PID] )
				        RETURN
				            ROW(
				                "Projects", CONCATENATEX( _inc, [PID], "+", [PID], ASC ),
				                "ProjectCount", COUNTROWS( _inc ) + 0,
				                "CapexUSD", SUMX( _inc, [Capex] ) + 0,
				                "GrowthCount", SUMX( _inc, [Growth] ) + 0,
				                "MissingDependencies", COUNTROWS( FILTER( _inc, [Dep] <> "" && NOT ( [Dep] IN _incIds ) ) ) + 0,
				                "Conflicts", COUNTROWS( FILTER( _inc, [Exc] <> "" && [Exc] IN _incIds ) ) + 0,
				                "NPVLow", SUMX( _inc, [NL] ) + 0,
				                "NPVExpected", SUMX( _inc, [NE] ) + 0,
				                "NPVHigh", SUMX( _inc, [NH] ) + 0,
				                "NetCashExpected", SUMX( _inc, [CE] ) + 0,
				                "RunRate2032Expected", SUMX( _inc, [RE] ) + 0
				            )
				    )
				RETURN
				    SELECTCOLUMNS(
				        _U,
				        "Mask", [Value],
				        "Projects", [Projects],
				        "ProjectCount", [ProjectCount],
				        "CapexUSD", [CapexUSD],
				        "GrowthCount", [GrowthCount],
				        "MissingDependencies", [MissingDependencies],
				        "Conflicts", [Conflicts],
				        "IsValid", IF( [CapexUSD] <= _Budget && [ProjectCount] >= 3 && [GrowthCount] >= 1 && [MissingDependencies] = 0 && [Conflicts] = 0, 1, 0 ),
				        "NPVLow", [NPVLow],
				        "NPVExpected", [NPVExpected],
				        "NPVHigh", [NPVHigh],
				        "NetCashExpected", [NetCashExpected],
				        "RunRate2032Expected", [RunRate2032Expected],
				        "Option", VAR _k = [Projects] RETURN LOOKUPVALUE( 'Portfolio Option'[Portfolio], 'Portfolio Option'[ProjectsKey], _k )
				    )

	annotation PBI_Id = 7c0c046c5be244d28cc6fc6eb1d8dc16

