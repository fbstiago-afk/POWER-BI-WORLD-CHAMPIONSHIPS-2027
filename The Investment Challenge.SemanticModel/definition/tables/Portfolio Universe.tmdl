/// Every one of the 1,024 combinations of the ten Goodnight Inn proposals, with the challenge rules applied (budget, >= 3 projects, >= 1 growth initiative, DependsOn, ExclusiveWith) and additive value from Project Value.
table 'Portfolio Universe'
	lineageTag: 15e6dca9-af13-48a3-aa53-a8a0f3c7947f

	column Mask
		isHidden
		lineageTag: ba57d246-600a-42db-ad42-dec3df70e11d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mask]

	column Projects
		lineageTag: 0c3669de-db46-4767-b209-ee4fcc80048e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Projects]

	column ProjectCount
		lineageTag: a0bdc461-6e37-44b8-b339-c37b06a53b39
		summarizeBy: none
		isNameInferred
		sourceColumn: [ProjectCount]

	column CapexUSD
		formatString: \$#,0
		lineageTag: b8675eb6-02f3-41c4-86df-62576b4db297
		summarizeBy: none
		isNameInferred
		sourceColumn: [CapexUSD]

	column GrowthCount
		lineageTag: c0c86249-53e1-4c0e-8b49-5e7d252f02e0
		summarizeBy: none
