	measure 'Title Waterfall' = VAR _d = [Profit Change 2023-2025] RETURN IF( _d < 0, "Where the " & FORMAT( -_d / 1e6, "$#,0.0" ) & "M of lost profit went", "Operating profit change by driver: +" & FORMAT( _d / 1e6, "$#,0.0" ) & "M" ) & " · 2023→2025"
