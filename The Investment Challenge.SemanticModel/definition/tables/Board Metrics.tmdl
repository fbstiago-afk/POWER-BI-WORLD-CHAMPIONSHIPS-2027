	measure 'CF Assessment Color' = IF( HASONEVALUE( InvestmentProjects[ProjectID] ), IF( [Project NPV] > 0, "#4DD1BD", IF( [Project Is Funded] = 1, "#F6B26B", "#FF8F82" ) ) )
		displayFolder: UX
		lineageTag: 4b06756b-5380-4121-9994-0a9abcf8acdc

	/// Diverging micro-bar of the project NPV to 2032 (scale +/- $30M, white tick = zero). Teal creates value, coral destroys it.
	measure 'SVG NPV Bar' =
			VAR _v = [Project NPV]
			VAR _scale = 30000000
			VAR _half = 70
			VAR _w = ROUND( MIN( ABS( _v ) / _scale, 1 ) * _half, 0 )
			VAR _x = IF( _v >= 0, 75, 75 - _w )
			VAR _c = IF( _v >= 0, "#4DD1BD", "#FF8F82" )
			RETURN
			    IF(
			        HASONEVALUE( InvestmentProjects[ProjectID] ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='20' viewBox='0 0 150 20'>"
			            & "<rect x='5' y='9' width='140' height='2' fill='#22314F'/>"
			            & "<rect x='" & _x & "' y='4' width='" & MAX( _w, 2 ) & "' height='12' fill='" & _c & "'/>"
			            & "<line x1='75' x2='75' y1='0' y2='20' stroke='#F8F1E6' stroke-width='1.5'/></svg>"
			    )
		displayFolder: UX
		lineageTag: 21ca2d27-6bf4-47c1-8be8-d21acd1d7ef9
		dataCategory: ImageUrl

