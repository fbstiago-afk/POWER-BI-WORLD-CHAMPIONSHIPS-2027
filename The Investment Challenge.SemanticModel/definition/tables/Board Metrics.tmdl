			    RETURN SWITCH( TRUE(), _n < 0 && _d < -3, "● Guests turning away", _n < 0, "● Negative NPS", _o >= 0.9, "◆ Capacity-constrained", _d < -5, "▲ Fast NPS decline", "—" ) )
