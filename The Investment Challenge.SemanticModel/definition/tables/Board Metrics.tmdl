	measure 'Universe Value Creating Low' = CALCULATE( COUNTROWS( 'Portfolio Universe' ), REMOVEFILTERS( 'Portfolio Universe' ), 'Portfolio Universe'[IsValid] = 1, 'Portfolio Universe'[NPVLow] > 0 ) + 0
		formatString: #,0
		displayFolder: Investment
		lineageTag: 6053227d-8f74-4c46-a817-c70284603001

	/// Portfolio NPV in the selected scenario (row context of the Portfolio Universe).
	measure 'Universe NPV' =
			VAR _sc = [Selected Scenario]
			RETURN SWITCH( _sc, "Low", SUM( 'Portfolio Universe'[NPVLow] ), "High", SUM( 'Portfolio Universe'[NPVHigh] ), SUM( 'Portfolio Universe'[NPVExpected] ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Investment
		lineageTag: 6bd5cba2-ad7c-48d9-9756-6c493507c20e

	measure 'Universe Is Selected' = IF( SELECTEDVALUE( 'Portfolio Universe'[Option] ) = [Selected Portfolio], 1, 0 )
		formatString: 0
		displayFolder: Investment
		lineageTag: 8bdbe6bb-5ecb-47d8-932a-8afe21be2c8e

	/// Rank of the selected portfolio by NPV among all rule-compliant portfolios (selected scenario).
	measure 'Selected Portfolio Rank' =
			VAR _key = LOOKUPVALUE( 'Portfolio Option'[ProjectsKey], 'Portfolio Option'[Portfolio], [Selected Portfolio] )
			VAR _sc = [Selected Scenario]
			VAR _V = FILTER( ALL( 'Portfolio Universe' ), 'Portfolio Universe'[IsValid] = 1 )
			VAR _T = ADDCOLUMNS( _V, "N", SWITCH( _sc, "Low", 'Portfolio Universe'[NPVLow], "High", 'Portfolio Universe'[NPVHigh], 'Portfolio Universe'[NPVExpected] ) )
			VAR _mine = MAXX( FILTER( _T, 'Portfolio Universe'[Projects] = _key ), [N] )
			RETURN COUNTROWS( FILTER( _T, [N] > _mine ) ) + 1
		formatString: 0
		displayFolder: Investment
		lineageTag: 0b0c2beb-1e18-4a2d-a8ea-f801edd96eba

	measure 'Plan Funded Names' =
			VAR _opt = [Selected Portfolio]
			VAR _ids = SELECTCOLUMNS( FILTER( ALL( 'Portfolio Map' ), 'Portfolio Map'[Portfolio] = _opt ), "ProjectID", 'Portfolio Map'[ProjectID] )
			RETURN CONCATENATEX( CALCULATETABLE( InvestmentProjects, REMOVEFILTERS( InvestmentProjects ), TREATAS( _ids, InvestmentProjects[ProjectID] ) ), LOWER( LEFT( InvestmentProjects[Short Name], 1 ) ) & MID( InvestmentProjects[Short Name], 2, 200 ), ", ", InvestmentProjects[CapexUSD], DESC )
		displayFolder: UX
		lineageTag: bff4ad36-d530-428e-8f8a-a5ee95591284

	/// Marker size driver for the hotel scatter: hotels with an investment proposal are drawn larger.
	measure 'Hotel Emphasis' = IF( HASONEVALUE( Hotels[HotelID] ), IF( SELECTEDVALUE( Hotels[Hotel Role] ) = "Other hotels", 1, 4 ) )
