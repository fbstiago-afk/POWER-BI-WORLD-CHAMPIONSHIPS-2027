	measure 'Universe Value Creating Expected' = CALCULATE( COUNTROWS( 'Portfolio Universe' ), REMOVEFILTERS( 'Portfolio Universe' ), 'Portfolio Universe'[IsValid] = 1, 'Portfolio Universe'[NPVExpected] > 0 ) + 0
		formatString: #,0
		displayFolder: Investment
