	measure 'UX Why Profit' =
			VAR _vol = [Distribution Volume Effect 2023-2025]
			VAR _mix = [Distribution Mix Effect 2023-2025]
			VAR _rate = [Commission Rate Effect 2023-2025]
			VAR _dP = [Profit Change 2023-2025]
			VAR _s23 = [Staff Cost per Occupied Room 2023]
			VAR _s25 = [Staff Cost per Occupied Room 2025]
			VAR _r23 = [Revenue per Occupied Room 2023]
			VAR _r25 = [Revenue per Occupied Room 2025]
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6;font-size:20px'>"
			        & "<div style='color:#D7AB62;font-size:16px;letter-spacing:2px;font-weight:700;margin-bottom:8px'>WHAT THE DATA SHOWS — AND WHAT IT DOES NOT</div>"
			        & "<table style='width:100%;border-collapse:collapse'>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:14px 0;color:#CBD4E2'>Distribution: channel mix</td><td style='text-align:right;font-weight:600;color:#FF8F82'>" & FORMAT( _mix / 1e6, "$#,0.0;-$#,0.0" ) & "M" & "</td><td style='padding-left:14px;color:#9FB0C8;font-size:16px'>Observed: share moved to higher-fee OTAs</td></tr>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:14px 0;color:#CBD4E2'>Distribution: volume</td><td style='text-align:right;font-weight:600;color:#F8F1E6'>" & FORMAT( _vol / 1e6, "$#,0.0;-$#,0.0" ) & "M" & "</td><td style='padding-left:14px;color:#9FB0C8;font-size:16px'>Arithmetic: more room revenue at the 2023 rate</td></tr>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:14px 0;color:#CBD4E2'>Distribution: commission rates</td><td style='text-align:right;font-weight:600;color:#F8F1E6'>" & FORMAT( _rate / 1e6, "$#,0.0;-$#,0.0" ) & "M" & "</td><td style='padding-left:14px;color:#9FB0C8;font-size:16px'>Observed: rates identical every year, every channel</td></tr>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:14px 0;color:#CBD4E2'>Staff cost per occupied room</td><td style='text-align:right;font-weight:600;color:#F6B26B'>" & FORMAT( _s23, "$#,0.00" ) & " → " & FORMAT( _s25, "$#,0.00" ) & "</td><td style='padding-left:14px;color:#9FB0C8;font-size:16px'>Grew faster than revenue per room</td></tr>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:14px 0;color:#CBD4E2'>Revenue per occupied room</td><td style='text-align:right;font-weight:600;color:#F8F1E6'>" & FORMAT( _r23, "$#,0.00" ) & " → " & FORMAT( _r25, "$#,0.00" ) & "</td><td style='padding-left:14px;color:#9FB0C8;font-size:16px'>Price/mix gains did not cover costs</td></tr>"
			        & "</table>"
			        & "<div style='color:#9FB0C8;font-size:16px;margin-top:10px;line-height:1.45'>Decomposition is exact (volume + mix + rate = total change in distribution cost). <b style='color:#CBD4E2'>Not in the data:</b> why guests moved to OTAs — we report the shift, not its cause.</div>"
			        & "</div>"
		displayFolder: UX
		lineageTag: eea37925-50fa-4874-9d97-9c994f8b4033

	measure 'UX Hotel Opportunities' =
			VAR _full = CALCULATE( [Occupancy 2025], Hotels[Hotel Role] = "Full · extension proposed" )
			VAR _nf = CALCULATE( [Occupancy 2025], Hotels[Hotel Role] = "Not full · extension proposed" )
			VAR _old = CALCULATE( [NPS 2025], Hotels[Hotel Role] = "Oldest 10 (refresh)" )
			VAR _rest = CALCULATE( [NPS 2025], Hotels[Hotel Role] = "Other hotels" )
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6;font-size:18px;line-height:1.5'>"
			        & "<div style='color:#D7AB62;font-size:15px;letter-spacing:2px;font-weight:700;margin-bottom:6px'>WHERE THE PROPOSALS POINT · BRAND-WIDE</div>"
			        & "<div><span style='color:#4DD1BD'>◆ Capacity:</span> Toronto Pearson and London Gatwick run at " & FORMAT( _full, "0%" ) & " — real demand for the extensions. Kingston runs at " & FORMAT( _nf, "0%" ) & ".</div>"
			        & "<div style='margin-top:6px'><span style='color:#FF8F82'>● Condition:</span> the ten oldest hotels average NPS " & FORMAT( _old, "0.0" ) & " vs " & FORMAT( _rest, "0.0" ) & " elsewhere.</div>"
			        & "<div style='margin-top:6px;color:#9FB0C8'>Both needs are real; page 2 shows neither earns the 8% cost of capital by 2032.</div>"
			        & "</div>"
		displayFolder: UX
		lineageTag: 637bdccc-9005-4114-97a6-631f18cf59c5

	measure 'Project Rationale' =
			VAR _nl = [Project NPV Low] VAR _ne = [Project NPV Expected] VAR _f = [Project Is Funded]
			RETURN IF( HASONEVALUE( InvestmentProjects[ProjectID] ),
			    SWITCH( TRUE(),
			        _f = 1 && _ne > 0, "Selected: creates value by 2032 at 8% in the Expected case" & IF( _nl < 0, "; loses value in the Low case.", " and in the Low case." ),
			        _f = 1, "Selected as the lowest-cost way to meet the three-initiative rule; small value loss accepted.",
			        _ne > 0, "Not selected in this plan although it creates value.",
			        "Rejected: its benefits arrive too late or too small to repay CAPEX at 8% by 2032" & IF( [Project Disruption Cost] > 0, ", and rooms out of service during works cost profit.", "." ) ) )
		displayFolder: Investment
		lineageTag: 0e24fa61-6719-4d4b-87a6-d1c834e0b6f9

	measure 'Project Annual Benefit $M' = DIVIDE( [Project Annual Profit Expected], 1000000 )
		formatString: \$#,0.00
		displayFolder: Investment
		lineageTag: 1c497692-d0a4-43d2-95a7-d3ef2ee38ff0

	/// Rank of the project by standalone NPV to 2032 among the brand's ten proposals (selected scenario).
	measure 'Project NPV Rank' =
			IF( HASONEVALUE( InvestmentProjects[ProjectID] ),
			    VAR _b = SELECTEDVALUE( InvestmentProjects[Brand] ) VAR _me = [Project NPV]
			    VAR _T = ADDCOLUMNS( CALCULATETABLE( VALUES( InvestmentProjects[ProjectID] ), REMOVEFILTERS( InvestmentProjects ), InvestmentProjects[Brand] = _b ), "N", VAR _p = InvestmentProjects[ProjectID] RETURN CALCULATE( [Project NPV], REMOVEFILTERS( InvestmentProjects ), InvestmentProjects[ProjectID] = _p ) )
			    RETURN COUNTROWS( FILTER( _T, [N] > _me ) ) + 1 )
		formatString: 0
		displayFolder: Investment
		lineageTag: def83d17-51b2-44b2-b4ec-93e502fe62c8

	/// Project NPV in the Low case, $M.
	measure 'Project NPV Low $M' = DIVIDE( [Project NPV Low], 1000000 )
		formatString: \$#,0.00;-\$#,0.00;\$0.00
		displayFolder: Investment
		lineageTag: 11ad8884-fff2-473a-abb9-7f2ac4e82f78

	/// Page 2 decision hero: recommendation, capital, expected value and downside. Always shows Expected and Low, whatever scenario is selected in the explorer.
	measure 'UX Hero Decision' =
			VAR _pf = [Selected Portfolio]
			VAR _capex = CALCULATE( [Portfolio CAPEX], REMOVEFILTERS( InvestmentProjects ) )
			VAR _bud = [Brand Budget]
			VAR _rem = _bud - _capex
			VAR _npvE = [Plan NPV 2026 Expected]
			VAR _npvL = [Plan NPV 2026 Low]
			VAR _npvH = [Plan NPV 2026 High]
			VAR _be = CALCULATE( [Plan Breakeven Impact %], Scenario[Scenario] = "Expected" )
			VAR _cashL = CALCULATE( [Plan Net Cash to 2032], Scenario[Scenario] = "Low" )
			VAR _pb = CALCULATE( [Plan Payback Year], Scenario[Scenario] = "Expected" )
			VAR _rankE = CALCULATE( [Selected Portfolio Rank], Scenario[Scenario] = "Expected" )
			VAR _valid = [Universe Valid]
			VAR _head = IF( _pf = "Recommended" && _rankE = 1, "Invest " & FORMAT( _capex / 1e6, "$#,0.0;-$#,0.0" ) & "M" & ". Keep " & FORMAT( _rem / 1e6, "$#,0.0;-$#,0.0" ) & "M in reserve.", _pf & ": " & FORMAT( _capex / 1e6, "$#,0.0;-$#,0.0" ) & "M" & ", NPV " & IF( _npvE >= 0, "+", "−" ) & FORMAT( ABS( _npvE ) / 1e6, "$#,0.0" ) & "M" & " — rank " & _rankE & " of " & FORMAT( _valid, "#,0" ) & "." )
			VAR _dek = IF( _pf = "Recommended", "Win back the direct guest: direct booking app, revenue management and self check-in. Best of " & FORMAT( _valid, "#,0" ) & " rule-compliant plans in every scenario.", SELECTEDVALUE( 'Portfolio Option'[Thesis], "" ) )
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6;padding:4px 8px 0 4px'>"
			        & "<div style='color:#D7AB62;font-size:14px;letter-spacing:2.4px;font-weight:700'>02 · THE DECISION · " & UPPER( _pf ) & " PORTFOLIO · NPV AT 8% TO 2032 · 2025 USD</div>"
			        & "<div style='font-family:Segoe UI Semibold,Segoe UI,sans-serif;font-size:40px;line-height:1.08;margin:8px 0 6px 0;letter-spacing:-0.6px'>" & _head & "</div>"
			        & "<div style='color:#CBD4E2;font-size:19px;line-height:1.35;margin-bottom:12px'>" & _dek & "</div>"
			        & "<div style='display:flex'>"
			        & "<div style='flex:1;min-width:0;padding:13px 18px 11px 20px;background:#102747;border-left:4px solid #D7AB62;border-radius:8px;margin-right:18px'><div style='color:#9FB0C8;font-size:13px;letter-spacing:1.6px;font-weight:600;text-transform:uppercase'>Capital invested</div><div style='display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:4px'><div style='color:#F8F1E6;font-size:36px;font-weight:600;line-height:1.1;margin-top:0;white-space:nowrap;font-family:Segoe UI Semibold,Segoe UI,sans-serif'>" & FORMAT( _capex / 1e6, "$#,0.0;-$#,0.0" ) & "M" & "</div><div style='color:" & "#CBD4E2" & ";font-size:15px;line-height:1.25;text-align:right;flex:0 1 55%;min-width:0'>" & "of " & FORMAT( _bud / 1e6, "$#,0.0;-$#,0.0" ) & "M" & " · " & FORMAT( _rem / 1e6, "$#,0.0;-$#,0.0" ) & "M" & " held in reserve" & "</div></div></div>"
			        & "<div style='flex:1;min-width:0;padding:13px 18px 11px 20px;background:#102747;border-left:4px solid #D7AB62;border-radius:8px;margin-right:18px'><div style='color:#9FB0C8;font-size:13px;letter-spacing:1.6px;font-weight:600;text-transform:uppercase'>Value created · Expected</div><div style='display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:4px'><div style='color:#F8F1E6;font-size:36px;font-weight:600;line-height:1.1;margin-top:0;white-space:nowrap;font-family:Segoe UI Semibold,Segoe UI,sans-serif'>" & IF( _npvE >= 0, "+", "−" ) & FORMAT( ABS( _npvE ) / 1e6, "$#,0.0" ) & "M" & "</div><div style='color:" & IF( _npvE > 0, "#4DD1BD", "#FF8F82" ) & ";font-size:15px;line-height:1.25;text-align:right;flex:0 1 55%;min-width:0'>" & "NPV · break-even at " & FORMAT( _be, "0%" ) & " of expected impact · payback " & _pb & "</div></div></div>"
			        & "<div style='flex:1;min-width:0;padding:13px 18px 11px 20px;background:#102747;border-left:4px solid #D7AB62;border-radius:8px;margin-right:18px'><div style='color:#9FB0C8;font-size:13px;letter-spacing:1.6px;font-weight:600;text-transform:uppercase'>Risk · Low case</div><div style='display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:4px'><div style='color:#F8F1E6;font-size:36px;font-weight:600;line-height:1.1;margin-top:0;white-space:nowrap;font-family:Segoe UI Semibold,Segoe UI,sans-serif'>" & IF( _npvL >= 0, "+", "−" ) & FORMAT( ABS( _npvL ) / 1e6, "$#,0.0" ) & "M" & "</div><div style='color:" & "#F6B26B" & ";font-size:15px;line-height:1.25;text-align:right;flex:0 1 55%;min-width:0'>" & "NPV · net cash " & IF( _cashL >= 0, "+", "−" ) & FORMAT( ABS( _cashL ) / 1e6, "$#,0.0" ) & "M" & " by 2032 · High " & IF( _npvH >= 0, "+", "−" ) & FORMAT( ABS( _npvH ) / 1e6, "$#,0.0" ) & "M" & "</div></div></div>"
			        & "</div></div>"
		displayFolder: UX
		lineageTag: 5b2bb136-6c6d-406d-aef8-96f294ce6ada

	measure 'UX Decision Statement' =
			VAR _pf = [Selected Portfolio]
			VAR _capex = CALCULATE( [Portfolio CAPEX], REMOVEFILTERS( InvestmentProjects ) )
			VAR _rem = [Budget Remaining]
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;display:flex;align-items:center;height:100%;color:#F8F1E6;border-top:1px solid #D7AB62;padding-top:6px;font-size:18px'>"
			        & "<span style='color:#D7AB62;font-size:13px;letter-spacing:2px;font-weight:700;margin-right:20px;white-space:nowrap'>BOARD DECISION</span>"
			        & IF( _pf = "Recommended", "Approve " & FORMAT( _capex / 1e6, "$#,0.0" ) & "M from January 2027; hold " & FORMAT( _rem / 1e6, "$#,0.0" ) & "M. Re-test extensions and the room refresh with 2027 results.",
			            "<span style='color:#F6B26B'>Alternative under review — reset to return to the recommendation.</span>" )
			        & "</div>"
		displayFolder: UX
		lineageTag: 94742ec6-7a61-4b46-b86b-064b537b417b

	measure 'UX Scenario Card' =
			VAR _pf = [Selected Portfolio]
			VAR _l = [Plan NPV 2026 Low] VAR _e = [Plan NPV 2026 Expected] VAR _h = [Plan NPV 2026 High]
			VAR _cl = CALCULATE( [Plan Net Cash to 2032], Scenario[Scenario] = "Low" )
			VAR _ce = CALCULATE( [Plan Net Cash to 2032], Scenario[Scenario] = "Expected" )
			VAR _ch = CALCULATE( [Plan Net Cash to 2032], Scenario[Scenario] = "High" )
			VAR _rl = CALCULATE( [Plan Run-Rate Uplift 2032], Scenario[Scenario] = "Low" )
			VAR _re = CALCULATE( [Plan Run-Rate Uplift 2032], Scenario[Scenario] = "Expected" )
			VAR _rh = CALCULATE( [Plan Run-Rate Uplift 2032], Scenario[Scenario] = "High" )
			VAR _be = CALCULATE( [Plan Breakeven Impact %], Scenario[Scenario] = "Expected" )
			VAR _posL = [Universe Value Creating Low]
			VAR _cell = ( 0 )
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6;font-size:19px'>"
			        & "<div style='color:#D7AB62;font-size:13px;letter-spacing:2px;font-weight:700;margin-bottom:10px'>" & UPPER( _pf ) & " · SENSITIVITY TO THE DATASET SCENARIOS</div>"
			        & "<table style='width:100%;border-collapse:collapse;font-size:19px'>"
			        & "<tr style='color:#9FB0C8;font-size:14px'><td></td><td style='text-align:right'>LOW</td><td style='text-align:right'>EXPECTED</td><td style='text-align:right'>HIGH</td></tr>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:16px 0;color:#CBD4E2'>NPV to 2032</td><td style='text-align:right;color:#FF8F82'>" & IF( _l >= 0, "+", "−" ) & FORMAT( ABS( _l ) / 1e6, "$#,0.0" ) & "M" & "</td><td style='text-align:right'>" & IF( _e >= 0, "+", "−" ) & FORMAT( ABS( _e ) / 1e6, "$#,0.0" ) & "M" & "</td><td style='text-align:right;color:#4DD1BD'>" & IF( _h >= 0, "+", "−" ) & FORMAT( ABS( _h ) / 1e6, "$#,0.0" ) & "M" & "</td></tr>"
			        & "<tr style='border-bottom:1px solid #22314F'><td style='padding:16px 0;color:#CBD4E2'>Net cash 2027–32</td><td style='text-align:right'>" & IF( _cl >= 0, "+", "−" ) & FORMAT( ABS( _cl ) / 1e6, "$#,0.0" ) & "M" & "</td><td style='text-align:right'>" & IF( _ce >= 0, "+", "−" ) & FORMAT( ABS( _ce ) / 1e6, "$#,0.0" ) & "M" & "</td><td style='text-align:right'>" & IF( _ch >= 0, "+", "−" ) & FORMAT( ABS( _ch ) / 1e6, "$#,0.0" ) & "M" & "</td></tr>"
			        & "<tr><td style='padding:16px 0;color:#CBD4E2'>Profit added / yr, 2032</td><td style='text-align:right'>" & IF( _rl >= 0, "+", "−" ) & FORMAT( ABS( _rl ) / 1e6, "$#,0.0" ) & "M" & "</td><td style='text-align:right'>" & IF( _re >= 0, "+", "−" ) & FORMAT( ABS( _re ) / 1e6, "$#,0.0" ) & "M" & "</td><td style='text-align:right'>" & IF( _rh >= 0, "+", "−" ) & FORMAT( ABS( _rh ) / 1e6, "$#,0.0" ) & "M" & "</td></tr>"
			        & "</table>"
			        & "<div style='margin-top:14px;line-height:1.5;color:#CBD4E2'>Staying inside the budget does not make a plan safe: <b style='color:#F6B26B'>" & _posL & " of " & FORMAT( [Universe Valid], "#,0" ) & "</b> compliant plans create value in the Low case. This one breaks even at <b>" & FORMAT( _be, "0%" ) & "</b> of the expected impact.</div>"
			        & "</div>"
		displayFolder: UX
		lineageTag: 82e0a3e8-0fbe-4a14-961a-4d3582f22cbc

	/// Annual discount factor at the FinanceParameters rate, base 2026. Blank on totals.
	measure 'Plan Discount Factor' = IF( HASONEVALUE( 'Date'[Year] ), VAR _y = VALUES( 'Date'[Year] ) RETURN IF( _y >= 2027 && _y <= 2032, 1 / ( 1 + [Discount Rate] ) ^ ( _y - 2026 ) ) )
		formatString: 0.000
		displayFolder: Investment
		lineageTag: 0600bdd4-0c58-4de3-af0f-4e8ffbc923ea

	/// Present value of net cash; the 2027–2032 total equals Plan NPV 2026.
	measure 'Plan PV Net Cash' = SUMX( VALUES( 'Date'[Year] ), VAR _y = 'Date'[Year] RETURN IF( _y >= 2027 && _y <= 2032, CALCULATE( [Plan Net Cash Flow] ) / ( 1 + [Discount Rate] ) ^ ( _y - 2026 ) ) )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Investment
		lineageTag: 1985d3c5-b251-4406-a2ee-c9315e868464

	measure 'Plan Cumulative Net Cash Low' = CALCULATE( [Plan Cumulative Net Cash], Scenario[Scenario] = "Low" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Investment
		lineageTag: 8106c0b9-8e7c-4ecb-91fb-4d99687fc99e

	measure 'Plan Cumulative Net Cash Expected' = CALCULATE( [Plan Cumulative Net Cash], Scenario[Scenario] = "Expected" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Investment
		lineageTag: 8338a1bf-0291-46f8-8b86-5fbe31cede33

	measure 'Plan Cumulative Net Cash High' = CALCULATE( [Plan Cumulative Net Cash], Scenario[Scenario] = "High" )
		formatString: \$#,0;-\$#,0;\$0
		displayFolder: Investment
		lineageTag: fc22cfcf-8d55-4703-b818-cd97de3d4f33

	measure 'UX NPV Method' =
			VAR _sc = [Selected Scenario]
			RETURN
			VAR _r = [Discount Rate]
			VAR _pvB = [Plan PV Benefits]
			VAR _pvC = [Plan PV Costs]
			VAR _npv = [Plan NPV 2026]
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6;font-size:17px;line-height:1.5'>"
			        & "<div style='color:#D7AB62;font-size:13px;letter-spacing:2px;font-weight:700;margin-bottom:8px'>METHOD · " & UPPER( [Selected Portfolio] ) & " · " & UPPER( [Selected Scenario] ) & " CASE</div>"
			        & "<div><b>NPV</b> = Σ net cash of each year 2027–2032 ÷ (1 + " & FORMAT( _r, "0%" ) & ")^(year − 2026). Rate and base year come from FinanceParameters. No value is counted after 2032.</div>"
			        & "<div style='margin-top:6px'><b>Net cash</b> = profit uplift − profit lost during works − CAPEX. CAPEX is spread evenly over each project's works; benefits start the month after completion at 50%, then 85%, then 100%.</div>"
			        & "<div style='margin-top:6px'><b>Profit uplift</b> = the dataset's AnnualOperatingProfitImpactUSD, already net of running and distribution costs (verified), in 2025 USD.</div>"
			        & "<div style='margin-top:6px'><b>Operating profit</b> = revenue − operating expenses − distribution cost. <b>Payback</b> = first year cumulative net cash ≥ 0.</div>"
			        & "<div style='margin-top:12px;padding-top:8px;border-top:1px solid #334462'>PV of benefits <b>" & FORMAT( _pvB / 1e6, "$#,0.0;-$#,0.0" ) & "M" & "</b> − PV of CAPEX and works losses <b>" & FORMAT( _pvC / 1e6, "$#,0.0;-$#,0.0" ) & "M" & "</b> = NPV <b style='color:" & IF( _npv >= 0, "#4DD1BD", "#FF8F82" ) & "'>" & IF( _npv >= 0, "+", "−" ) & FORMAT( ABS( _npv ) / 1e6, "$#,0.0" ) & "M" & "</b></div>"
			        & "</div>"
		displayFolder: UX
		lineageTag: 62bf9c97-d1cd-4d3b-a1ec-051fe99c7aad

	measure 'UX Low Scenario' =
			VAR _l = [Plan NPV 2026 Low]
			VAR _e = [Plan NPV 2026 Expected]
			VAR _cl = CALCULATE( [Plan Net Cash to 2032], Scenario[Scenario] = "Low" )
			VAR _bl = CALCULATE( [Plan Breakeven Impact %], Scenario[Scenario] = "Low" )
			VAR _rl = CALCULATE( [Plan Run-Rate Uplift 2032], Scenario[Scenario] = "Low" )
			VAR _re = CALCULATE( [Plan Run-Rate Uplift 2032], Scenario[Scenario] = "Expected" )
			VAR _T = ADDCOLUMNS( FILTER( ALL( InvestmentProjects[ProjectID], InvestmentProjects[Short Name] ), [Project Is Funded] = 1 ), "@e", [Project NPV Expected], "@l", [Project NPV Low] )
			VAR _top = TOPN( 1, _T, [@e] - [@l], DESC )
			VAR _sw = IF( COUNTROWS( _T ) > 0, "The largest swing is " & MAXX( _top, InvestmentProjects[ProjectID] & " " & InvestmentProjects[Short Name] ) & ": NPV " & IF( MAXX( _top, [@e] ) >= 0, "+", "−" ) & FORMAT( ABS( MAXX( _top, [@e] ) ) / 1e6, "$#,0.0" ) & "M" & " expected vs " & IF( MAXX( _top, [@l] ) >= 0, "+", "−" ) & FORMAT( ABS( MAXX( _top, [@l] ) ) / 1e6, "$#,0.0" ) & "M" & " in the Low case.", "" )
			RETURN
			    "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6;font-size:18px;line-height:1.5'>"
			        & "<div style='color:#D7AB62;font-size:13px;letter-spacing:2px;font-weight:700;margin-bottom:8px'>IF THE LOW CASE HAPPENS · " & UPPER( [Selected Portfolio] ) & "</div>"
			        & "<div style='font-size:34px;font-family:Segoe UI Semibold,Segoe UI,sans-serif;color:#FF8F82;margin-bottom:6px'>NPV " & IF( _l >= 0, "+", "−" ) & FORMAT( ABS( _l ) / 1e6, "$#,0.0" ) & "M" & "</div>"
			        & "<div>Profit added falls from " & FORMAT( _re / 1e6, "$#,0.0;-$#,0.0" ) & "M" & " to " & FORMAT( _rl / 1e6, "$#,0.0;-$#,0.0" ) & "M" & " a year; capital is " & IF( _cl < 0, "<b>not recovered</b> by 2032 (net cash " & IF( _cl >= 0, "+", "−" ) & FORMAT( ABS( _cl ) / 1e6, "$#,0.0" ) & "M" & ").", "recovered by 2032." ) & "</div>"
			        & "<div style='margin-top:8px'>To break even in the Low case the plan would need " & FORMAT( _bl, "0%" ) & " of the Low impact. " & _sw & "</div>"
			        & "<div style='margin-top:8px;color:#9FB0C8'>Mitigation inside the data: the plan commits only " & FORMAT( CALCULATE( [Portfolio CAPEX], REMOVEFILTERS( InvestmentProjects ) ) / 1e6, "$0.0" ) & "M" & IF( [Selected Portfolio] = "Recommended", "; every other named plan loses more in the Low case (see Scenario explorer).", "." ) & "</div>"
			        & "</div>"
		displayFolder: UX
		lineageTag: a746280c-92ff-42cd-bc5b-026cd8616713

	measure 'Alt Flows Table' = "Table of yearly cash flows 2027 to 2032 for the selected plan and scenario: CAPEX, profit uplift, works losses, net cash, discount factor and present value."
		displayFolder: UX
		lineageTag: 566b7659-5624-4744-b6e4-cb81058994ef

	measure 'Alt Low Cash' = "Line chart of cumulative net cash 2027 to 2032 in Low, Expected and High cases for the selected plan."
		displayFolder: UX
		lineageTag: 65fb1f38-5d9a-4941-8cec-0b49cfa14277

	measure 'Alt Hotel Table' = "Table of hotels sorted by 2025 NPS, with region, occupancy, NPS change since 2021, operating margin and a risk flag."
		displayFolder: UX
		lineageTag: 6859a051-a1ce-4f21-bfc1-11e6c9d275ce

	measure 'Alt Region' = "Bar chart of operating margin by region, 2023 versus 2025."
		displayFolder: UX
		lineageTag: ed372709-ae45-4392-b096-2e4ebcff7037

	measure 'Alt Recommended Table' = "Table of the projects in the selected portfolio with CAPEX and NPV to 2032 in the Expected and Low cases."
		displayFolder: UX
		lineageTag: 75f1dbf1-09a5-4223-b711-c35c8c006751

	measure 'UX Hotel Heading' =
			VAR _n = [Hotels Negative NPS] VAR _f = [Hotels Above 90% Occupancy] VAR _h = [Hotels in View]
			RETURN "<div style='font-family:Segoe UI,Aptos,sans-serif;color:#F8F1E6'><div style='color:#D7AB62;font-size:13px;letter-spacing:2px;font-weight:700'>HOTEL EXPLORER · 2025 ACTUALS · " & _h & " HOTELS IN VIEW</div>"
			    & "<div style='font-family:Segoe UI Semibold,Segoe UI,sans-serif;font-size:34px;margin-top:6px'>" & _n & IF( _n = 1, " hotel is", " hotels are" ) & " losing guests' loyalty; " & _f & IF( _f = 1, " is", " are" ) & " already above 90% full.</div></div>"
		displayFolder: UX
		lineageTag: 40460705-1371-41d2-96bb-edd68386de91

	measure 'UX Tooltip Bridge' =
			VAR _step = SELECTEDVALUE( 'Profit Bridge Step'[Step], "Total change" )
			VAR _value = [Profit Bridge Value]
			VAR _total = [Profit Change 2023-2025]
			VAR _detail = SWITCH( _step, "Room revenue", "Room sales lifted profit before cost changes.", "F&B + other revenue", "Food, beverage and other sales added to profit.", "Staff cost", "Higher staffing cost absorbed revenue growth.", "Other operating costs", "Other running costs reduced the gain.", "Distribution: volume", "More room revenue raised distribution spend at the earlier cost rate.", "Distribution: channel mix", "The shift between booking channels raised distribution spend beyond volume alone.", "The combined drivers reconcile to the operating profit change." )
			RETURN "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>PROFIT BRIDGE · 2023—2025</div><div style='font-size:20px;font-weight:700;margin:8px 0'>" & _step & "</div><div style='font-size:30px;color:" & IF( _value < 0, "#FF8F82", "#4DD1BD" ) & "'>" & FORMAT( _value / 1e6, "+$0.00;-$0.00;$0.00" ) & "M</div><div style='font-size:13px;margin-top:9px'>" & _detail & "</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>Total profit change: " & FORMAT( _total / 1e6, "+$0.00;-$0.00;$0.00" ) & "M · source: 2023/2025 actuals</div></div>"
		displayFolder: UX
		lineageTag: 3d3e4c2e-bb00-42fb-b5bd-853eae1db101

	measure 'UX Tooltip Channel' =
			VAR _channel = SELECTEDVALUE( BookingChannels[Channel Short], "All channels" )
			VAR _year = SELECTEDVALUE( 'Date'[Year] )
			VAR _share = [Channel Share]
			VAR _prior = CALCULATE( [Channel Share], REMOVEFILTERS( 'Date' ), 'Date'[Year] = 2021 )
			VAR _cost = [Distribution Cost]
			VAR _rate = [Distribution Cost %]
			RETURN IF( ISBLANK( _year ), "<div style='font-family:Segoe UI;color:#F8F1E6;padding:14px'><div style='color:#D7AB62;font-size:12px;letter-spacing:2px'>CONTEXTUAL ANALYSIS</div><div style='font-size:18px;margin-top:12px'>Hover a year in the chart to see its drivers.</div></div>", "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>CHANNEL ECONOMICS · " & _year & "</div><div style='font-size:20px;font-weight:700;margin:8px 0'>" & _channel & "</div><div style='font-size:30px;color:#4DD1BD'>" & FORMAT( _share, "0.0%" ) & " <span style='font-size:13px;color:#9FB0C8'>of room nights</span></div><div style='font-size:13px;margin-top:9px'>" & FORMAT( (_share - _prior) * 100, "+0.0;-0.0;0.0" ) & " percentage points vs 2021 · " & FORMAT( [Channel Room Nights], "#,0" ) & " room nights</div><div style='font-size:13px;margin-top:6px'>Distribution cost " & FORMAT( _cost / 1e6, "$0.00" ) & "M · " & FORMAT( _rate, "0.0%" ) & " of channel room revenue</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>Share uses room nights; cost rate uses room revenue.</div></div>"
			    )
		displayFolder: UX
		lineageTag: 5ea9a0dd-6440-47b9-a96f-f5a31d1b71a1

	measure 'UX Tooltip Actual Trend' =
			VAR _year = SELECTEDVALUE( 'Date'[Year] )
			VAR _margin = [Operating Margin]
			VAR _prev = CALCULATE( [Operating Margin], REMOVEFILTERS( 'Date' ), 'Date'[Year] = _year - 1 )
			RETURN IF( ISBLANK( _year ), "<div style='font-family:Segoe UI;color:#F8F1E6;padding:14px'><div style='color:#D7AB62;font-size:12px;letter-spacing:2px'>CONTEXTUAL ANALYSIS</div><div style='font-size:18px;margin-top:12px'>Hover a year in the chart to see its drivers.</div></div>", "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>OPERATING PULSE · " & _year & "</div><div style='font-size:30px;font-weight:700;margin:9px 0'>" & FORMAT( _margin, "0.0%" ) & " <span style='font-size:13px;color:#9FB0C8'>margin</span></div><div style='font-size:13px'>Revenue " & FORMAT( [Revenue] / 1e6, "$0.0" ) & "M · profit " & FORMAT( [Operating Profit] / 1e6, "$0.0" ) & "M</div><div style='font-size:13px;margin-top:8px'>" & IF( ISBLANK( _prev ), "First year in the series", FORMAT( (_margin - _prev) * 100, "+0.0;-0.0;0.0" ) & " percentage points vs prior year" ) & "</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>Profit = revenue − operating expenses − distribution cost.</div></div>"
			    )
		displayFolder: UX
		lineageTag: 217019c0-511a-43fc-9f20-e6672e87c3a9

	measure 'UX Tooltip Region' =
			VAR _region = SELECTEDVALUE( Hotels[Region], "Selected region" )
			VAR _m23 = [Operating Margin 2023]
			VAR _m25 = [Operating Margin 2025]
			RETURN "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>REGIONAL MARGIN · 2023—2025</div><div style='font-size:20px;font-weight:700;margin:8px 0'>" & _region & "</div><div style='font-size:30px;color:" & IF( _m25 < _m23, "#FF8F82", "#4DD1BD" ) & "'>" & FORMAT( (_m25 - _m23) * 100, "+0.0;-0.0;0.0" ) & " pp</div><div style='font-size:13px;margin-top:9px'>2023 margin " & FORMAT( _m23, "0.0%" ) & " → 2025 margin " & FORMAT( _m25, "0.0%" ) & "</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>Revenue weighted operating margin for hotels in this region.</div></div>"
		displayFolder: UX
		lineageTag: 44723db2-2406-494b-a82c-c32d2db1fd65

	measure 'UX Tooltip Profit Path' =
			VAR _year = SELECTEDVALUE( 'Date'[Year] )
			VAR _actual = [Profit Actual]
			VAR _plan = [Profit With Plan]
			VAR _base = [Profit Baseline]
			RETURN IF( ISBLANK( _year ), "<div style='font-family:Segoe UI;color:#F8F1E6;padding:14px'><div style='color:#D7AB62;font-size:12px;letter-spacing:2px'>CONTEXTUAL ANALYSIS</div><div style='font-size:18px;margin-top:12px'>Hover a year in the chart to see its drivers.</div></div>", "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>PROFIT PATH · " & _year & " · " & UPPER( [Selected Scenario] ) & "</div><div style='font-size:30px;font-weight:700;margin:9px 0'>" & FORMAT( IF( _year <= 2025, _actual, _plan ) / 1e6, "$0.00" ) & "M</div><div style='font-size:13px'>" & IF( _year <= 2025, "Observed operating profit", "Projected operating profit with " & [Selected Portfolio] ) & "</div><div style='font-size:13px;margin-top:8px'>" & IF( _year <= 2025, "Margin " & FORMAT( [Operating Margin], "0.0%" ), "2025 baseline " & FORMAT( _base / 1e6, "$0.00" ) & "M · plan uplift " & FORMAT( (_plan - _base) / 1e6, "+$0.00;-$0.00;$0.00" ) & "M" ) & "</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>Projection in constant 2025 USD; scenario and portfolio follow the page selection.</div></div>"
			    )
		displayFolder: UX
		lineageTag: e2fb8226-c115-4322-a9f9-4f92802db812

	measure 'UX Tooltip Cash Flow' =
			VAR _year = SELECTEDVALUE( 'Date'[Year] )
			VAR _net = [Plan Net Cash Flow]
			VAR _cum = [Plan Cumulative Net Cash]
			RETURN IF( ISBLANK( _year ), "<div style='font-family:Segoe UI;color:#F8F1E6;padding:14px'><div style='color:#D7AB62;font-size:12px;letter-spacing:2px'>CONTEXTUAL ANALYSIS</div><div style='font-size:18px;margin-top:12px'>Hover a year in the chart to see its drivers.</div></div>", "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>CASH FLOW · " & _year & " · " & UPPER( [Selected Scenario] ) & "</div><div style='font-size:30px;font-weight:700;margin:9px 0;color:" & IF( _net < 0, "#FF8F82", "#4DD1BD" ) & "'>" & FORMAT( _net / 1e6, "+$0.00;-$0.00;$0.00" ) & "M</div><div style='font-size:13px'>Profit added " & FORMAT( [Plan Profit Uplift] / 1e6, "$0.00" ) & "M − works loss " & FORMAT( [Plan Disruption Cost] / 1e6, "$0.00" ) & "M − CAPEX " & FORMAT( [Plan CAPEX Spend] / 1e6, "$0.00" ) & "M</div><div style='font-size:13px;margin-top:8px'>Cumulative net cash through " & _year & ": " & FORMAT( _cum / 1e6, "+$0.00;-$0.00;$0.00" ) & "M</div><div style='font-size:12px;margin-top:6px'>Cumulative range: Low " & FORMAT( [Plan Cumulative Net Cash Low] / 1e6, "+$0.00;-$0.00;$0.00" ) & "M · Expected " & FORMAT( [Plan Cumulative Net Cash Expected] / 1e6, "+$0.00;-$0.00;$0.00" ) & "M · High " & FORMAT( [Plan Cumulative Net Cash High] / 1e6, "+$0.00;-$0.00;$0.00" ) & "M</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>Undiscounted cash. NPV applies the " & FORMAT( [Discount Rate], "0%" ) & " discount rate.</div></div>"
			    )
		displayFolder: UX
		lineageTag: 991515a1-2aaa-4c86-bbf8-b9da465a5ab0

	measure 'UX Tooltip Portfolio' =
			VAR _plan = [Selected Portfolio]
			VAR _low = [Plan NPV 2026 Low]
			VAR _exp = [Plan NPV 2026 Expected]
			VAR _high = [Plan NPV 2026 High]
			RETURN "<div style='font-family:Segoe UI;color:#F8F1E6;padding:10px'><div style='color:#D7AB62;font-size:11px;letter-spacing:2px'>PORTFOLIO STRESS TEST</div><div style='font-size:20px;font-weight:700;margin:8px 0'>" & _plan & "</div><div style='font-size:30px;color:" & IF( _exp < 0, "#FF8F82", "#4DD1BD" ) & "'>" & FORMAT( _exp / 1e6, "+$0.00;-$0.00;$0.00" ) & "M <span style='font-size:13px;color:#9FB0C8'>Expected NPV</span></div><div style='font-size:13px;margin-top:9px'>Low " & FORMAT( _low / 1e6, "+$0.00;-$0.00;$0.00" ) & "M · High " & FORMAT( _high / 1e6, "+$0.00;-$0.00;$0.00" ) & "M</div><div style='font-size:13px;margin-top:6px'>CAPEX committed " & FORMAT( [Portfolio CAPEX] / 1e6, "$0.00" ) & "M · Low-to-High spread " & FORMAT( (_high - _low) / 1e6, "$0.00" ) & "M</div><div style='color:#9FB0C8;font-size:12px;margin-top:10px'>NPV is discounted to 2026; the spread shows scenario sensitivity.</div></div>"
		displayFolder: UX
		lineageTag: b5e254c0-ff18-43bd-ac80-9f47b55d55c6

	column Ref
		isHidden
		formatString: 0
		lineageTag: f8e6c46b-870e-4506-98b4-725d29c78350
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ref]

	partition 'Board Metrics' = calculated
		mode: import
		source = ROW( "Ref", 0 )

	annotation PBI_Id = 34fade74dbca4c7cb8baa0cc066ce5fc

